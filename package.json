{
  "name": "unseenprompt",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:db": "supabase test db",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview --port 8787",
    "cf:types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv",
    "cf:types:check": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --check",
    "check:workers-deps": "node scripts/assert-workers-dependencies.mjs",
    "cf:dry-run:preview": "APP_ENV=preview NEXT_PUBLIC_APP_URL=https://preview.unseenprompt.com RELEASE_SHA=preview MAINTENANCE_MODE=off opennextjs-cloudflare build --env preview && wrangler deploy --env preview --dry-run",
    "cf:dry-run:staging": "APP_ENV=staging NEXT_PUBLIC_APP_URL=https://staging.unseenprompt.com RELEASE_SHA=staging MAINTENANCE_MODE=off opennextjs-cloudflare build --env staging && wrangler deploy --env staging --dry-run",
    "cf:dry-run:production": "APP_ENV=production NEXT_PUBLIC_APP_URL=https://unseenprompt.com RELEASE_SHA=production MAINTENANCE_MODE=off opennextjs-cloudflare build --env production && wrangler deploy --env production --dry-run",
    "test:preview:assert": "node scripts/assert-cloudflare-preview.mjs",
    "test:cf-preview": "start-server-and-test cf:preview http://127.0.0.1:8787 test:preview:assert",
    "test:cf-deployment": "node scripts/assert-cloudflare-deployment.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "motion": "12.42.2",
    "next": "16.2.12",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.0",
    "postcss": "8.5.24",
    "prettier": "3.9.6",
    "shadcn": "4.16.0",
    "start-server-and-test": "3.0.11",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0",
    "wrangler": "4.114.0",
    "yaml": "2.9.0"
  }
}
