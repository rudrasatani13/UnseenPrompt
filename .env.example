# Safe local defaults only. Never put credentials in this file.
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
RELEASE_SHA=local
MAINTENANCE_MODE=off

# Phase 4 application auth (public client values; RLS is the enforcement layer).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_test_value_000000000000

