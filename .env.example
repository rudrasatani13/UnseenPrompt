# Safe local defaults only. Never put credentials in this file.
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
RELEASE_SHA=local
MAINTENANCE_MODE=off

# Phase 4 application auth (public client values; RLS is the enforcement layer).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_test_value_000000000000

# Phase 5 model gateway: non-secret local route examples only. Uncomment and pair with
# credentials stored outside this committed template before invoking a model locally.
# MODEL_PRIMARY_PROVIDER=anthropic
# MODEL_PRIMARY_MODEL=claude-test-1
# MODEL_PRIMARY_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
# MODEL_PRIMARY_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0
# MODEL_FALLBACK_PROVIDER=openai
# MODEL_FALLBACK_MODEL=gpt-test-1
# MODEL_FALLBACK_INPUT_COST_MICROS_PER_MILLION_TOKENS=0
# MODEL_FALLBACK_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=0
# MODEL_TOTAL_DEADLINE_MS=30000
# MODEL_ATTEMPT_TIMEOUT_MS=12000
# MODEL_MAX_OUTPUT_TOKENS=4096

# Production waitlist only (never set for preview/staging). Values below are fake.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# SUPABASE_URL=https://waitlist.invalid
# SUPABASE_SECRET_KEY=sb_secret_local_test_value_000000000000
